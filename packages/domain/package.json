{
  "name": "@opensesh/domain",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./db/auth": "./src/db/auth.ts",
    "./db/schema": "./src/db/schema.ts",
    "./server/current-user": "./src/server/current-user.ts",
    "./server/cfp": "./src/server/cfp.ts",
    "./server/integrations/accelevents": "./src/server/integrations/accelevents.ts",
    "./server/errors": "./src/server/errors.ts",
    "./server/mail": "./src/server/mail.ts",
    "./server/mail/ics": "./src/server/mail/ics.ts",
    "./server/repos": "./src/server/repos/index.ts",
    "./server/schema/*": "./src/server/schema/*.ts",
    "./server/runtime": "./src/server/runtime.ts",
    "./server/db": "./src/server/db.ts",
    "./server/events": "./src/server/events.ts"
  },
  "scripts": {
    "check": "vp check",
    "db:generate": "drizzle-kit generate",
    "db:reset": "node --env-file=../../apps/web/.dev.vars --import tsx src/seed/reset.ts",
    "seed": "node --env-file=../../apps/web/.dev.vars --import tsx src/seed/index.ts",
    "cfp:verify": "node --env-file=../../apps/web/.dev.vars --import tsx src/seed/verify-cfp.ts",
    "review-desk:verify": "node --env-file=../../apps/web/.dev.vars --import tsx src/seed/verify-review-desk.ts",
    "mail:verify": "node --env-file=../../apps/web/.dev.vars --import tsx src/seed/verify-mail.ts",
    "seed:verify": "node --env-file=../../apps/web/.dev.vars --import tsx src/seed/verify.ts"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.106",
    "markdown-it": "^15.0.0",
    "nanoid": "5.1.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.1",
    "tsx": "4.20.5",
    "vitest": "^4.1.10"
  }
}
