{
  "name": "@opensesh/web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_WRITE_LOGS=false vp dev --port 3000",
    "check": "vp check",
    "build": "XDG_CONFIG_HOME=.wrangler/config WRANGLER_WRITE_LOGS=false vp build",
    "deploy": "vp build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply opensesh --local",
    "db:migrate:remote": "WRANGLER_WRITE_LOGS=false wrangler d1 migrations apply opensesh --remote",
    "db:reset": "node scripts/reset-db.mjs",
    "db:reset:remote": "node scripts/reset-db.mjs --remote",
    "seed": "WRANGLER_WRITE_LOGS=false wrangler d1 execute opensesh --local --file=../../packages/domain/seed.sql",
    "seed:verify": "node scripts/seed-verify.mjs"
  },
  "dependencies": {
    "@opensesh/domain": "workspace:*",
    "@tanstack/react-form": "^1.33.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.106",
    "lucide-react": "^1.30.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.132.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
