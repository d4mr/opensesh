{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensesh",
  "account_id": "a41a8466de6cfbc49087e3063094c1fd",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "app.opensesh.io", "custom_domain": true }],
  "vars": {
    "APP_ORIGIN": "https://app.opensesh.io",
    "MAIL_PROVIDER": "cloudflare",
    "MAIL_FROM": "auth@mail.opensesh.io",
  },
  // */15 resets the demo sandbox; the hourly cron sends task reminders.
  "triggers": { "crons": ["*/15 * * * *", "0 * * * *"] },
  "send_email": [{ "name": "EMAIL" }],
  "queues": {
    "producers": [{ "binding": "MAIL_QUEUE", "queue": "opensesh-mail" }],
    "consumers": [
      {
        "queue": "opensesh-mail",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "opensesh-files",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "444bb6f8798144dcaae2dd671459ac2d",
    },
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AppRunner"] },
    { "tag": "v2", "deleted_classes": ["AppRunner"] },
  ],
  // The database lives in aws-us-east-1; this placement hint runs the
  // Worker there deterministically, so query round trips stay ~1-5ms for
  // every visitor instead of tracking visitor geography.
  "placement": { "region": "aws:us-east-1" },
  "observability": { "enabled": true },
}
