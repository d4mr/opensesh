{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opensesh",
  "account_id": "a41a8466de6cfbc49087e3063094c1fd",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "routes": [{ "pattern": "app.opensesh.io", "custom_domain": true }],
  "vars": {
    "DEMO_MODE": "1",
    "MAIL_PROVIDER": "demo",
    "MAIL_FROM": "auth@opensesh.io",
  },
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "opensesh-files",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "444bb6f8798144dcaae2dd671459ac2d",
    },
  ],
  "placement": { "mode": "smart" },
}
