{
  "name": "opensesh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @opensesh/web#dev",
    "check": "vp run -r check",
    "typecheck": "pnpm check",
    "test": "vp test --passWithNoTests",
    "test:api-e2e": "vp run @opensesh/web#build && vp test --config apps/web/vitest.api.config.ts --run",
    "build": "vp run -r build",
    "deploy": "vp run @opensesh/web#deploy",
    "cf-typegen": "vp run @opensesh/web#cf-typegen",
    "db:generate": "vp run @opensesh/domain#db:generate",
    "db:reset": "pnpm --filter @opensesh/domain db:reset",
    "seed": "pnpm --filter @opensesh/domain seed",
    "seed:verify": "pnpm --filter @opensesh/domain seed:verify",
    "cfp:verify": "pnpm --filter @opensesh/domain cfp:verify",
    "review-desk:verify": "pnpm --filter @opensesh/domain review-desk:verify",
    "mail:verify": "pnpm --filter @opensesh/domain mail:verify"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "4.1.10",
    "wrangler": "^4.70.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
