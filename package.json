{
  "name": "opensesh",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run @opensesh/web#dev",
    "check": "vp run -r check",
    "typecheck": "pnpm check",
    "test": "vp test --passWithNoTests",
    "build": "vp run -r build",
    "deploy": "vp run @opensesh/web#deploy",
    "cf-typegen": "vp run @opensesh/web#cf-typegen",
    "db:generate": "vp run @opensesh/domain#db:generate",
    "db:migrate:local": "vp run @opensesh/web#db:migrate:local",
    "db:migrate:remote": "vp run @opensesh/web#db:migrate:remote",
    "db:reset": "pnpm --dir apps/web db:reset",
    "db:reset:remote": "pnpm --dir apps/web db:reset:remote",
    "seed": "pnpm --dir apps/web seed",
    "seed:verify": "pnpm --dir apps/web seed:verify"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.70.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    }
  }
}
